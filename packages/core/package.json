{
  "name": "@usegits/core",
  "version": "0.1.1",
  "description": "Core services for managing multi-repository task workspaces",
  "keywords": [
    "git",
    "monorepo",
    "workspace"
  ],
  "homepage": "https://github.com/Mobiwuhu/gits#readme",
  "bugs": {
    "url": "https://github.com/Mobiwuhu/gits/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Mobiwuhu",
    "url": "https://github.com/Mobiwuhu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mobiwuhu/gits.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "templates",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@usegits/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "build:watch": "tsdown --config-loader tsx --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bybrave/proper-lockfile2": "catalog:",
    "@scaffdog/core": "catalog:",
    "@scaffdog/engine": "catalog:",
    "@wendellhu/redi": "catalog:",
    "cron-parser": "catalog:",
    "globby": "catalog:",
    "jsonc-parser": "catalog:",
    "pino": "catalog:",
    "plist": "catalog:",
    "valibot": "catalog:"
  },
  "engines": {
    "node": ">=22.17.1"
  }
}
