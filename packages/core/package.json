{
  "name": "@usegit/core",
  "version": "0.1.1",
  "description": "Core services for managing multi-repository task workspaces",
  "keywords": [
    "git",
    "monorepo",
    "workspace"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "templates"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@usegit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "build:watch": "tsdown --config-loader tsx --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bybrave/proper-lockfile2": "catalog:",
    "@scaffdog/core": "catalog:",
    "@scaffdog/engine": "catalog:",
    "@wendellhu/redi": "catalog:",
    "cron-parser": "catalog:",
    "jsonc-parser": "catalog:",
    "pino": "catalog:",
    "plist": "catalog:"
  },
  "engines": {
    "node": ">=22.17.1"
  }
}
