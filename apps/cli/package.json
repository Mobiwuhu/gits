{
  "name": "@usegit/cli",
  "version": "0.1.1",
  "description": "Command-line interface for managing multi-repository task workspaces",
  "keywords": [
    "cli",
    "git",
    "monorepo",
    "workspace"
  ],
  "bin": {
    "gits": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "build:watch": "tsdown --config-loader tsx --watch",
    "dev": "TSX_TSCONFIG_PATH=../../tsconfig.base.json node --import=tsx --conditions=@usegit/source src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@usegit/core": "workspace:*",
    "@wendellhu/redi": "catalog:",
    "incur": "catalog:",
    "listr2": "catalog:",
    "table": "catalog:",
    "tsx": "catalog:"
  },
  "engines": {
    "node": ">=22.17.1"
  }
}
