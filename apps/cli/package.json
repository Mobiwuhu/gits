{
  "name": "@usegits/cli",
  "version": "0.1.1",
  "description": "Command-line interface for managing multi-repository task workspaces",
  "keywords": [
    "cli",
    "git",
    "monorepo",
    "workspace"
  ],
  "homepage": "https://github.com/Mobiwuhu/gits#readme",
  "bugs": {
    "url": "https://github.com/Mobiwuhu/gits/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Mobiwuhu",
    "url": "https://github.com/Mobiwuhu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mobiwuhu/gits.git",
    "directory": "apps/cli"
  },
  "bin": {
    "gits": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "build:watch": "tsdown --config-loader tsx --watch",
    "dev": "TSX_TSCONFIG_PATH=../../tsconfig.base.json node --import=tsx --conditions=@usegits/source src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@usegits/core": "workspace:*",
    "@wendellhu/redi": "catalog:",
    "incur": "catalog:",
    "listr2": "catalog:",
    "table": "catalog:",
    "tsx": "catalog:"
  },
  "engines": {
    "node": ">=22.17.1"
  }
}
