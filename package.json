{
  "name": "gits-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:watch": "pnpm --filter @gits/core build && pnpm --recursive --parallel --if-present run build:watch",
    "check": "pnpm format:check && pnpm lint && pnpm arch:check && pnpm build && pnpm typecheck && pnpm test",
    "arch:check": "node --import=tsx scripts/checkArchitecture.ts",
    "dev": "pnpm --filter gits dev",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "link:global": "pnpm build && pnpm --dir apps/cli link --global",
    "start": "pnpm --filter gits start",
    "test": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import=tsx --test apps/cli/src/service/CliApplication.integration.test.ts apps/cli/src/module/repoMirror/service/RepoMirrorCommand.integration.test.ts packages/core/src/service/ConcurrencyService.test.ts packages/core/src/service/gitUrl.test.ts packages/core/src/module/task/service/TaskConfigurationService.test.ts packages/core/src/module/task/service/TaskTemplateImportService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorLoggerService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorSchedulerService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorStoreService.test.ts packages/core/src/module/uninstall/service/GitsPersistenceService.test.ts",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.17.1",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9"
}
