{
  "name": "gits-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:watch": "pnpm --filter @gits/core build && pnpm --recursive --parallel --if-present run build:watch",
    "check": "pnpm lint && pnpm arch:check && pnpm typecheck && pnpm test && pnpm pack:check",
    "arch:check": "node --import=tsx scripts/checkArchitecture.ts",
    "dev": "pnpm --filter @gits/cli dev",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "link:global": "pnpm build && pnpm --dir apps/cli link --global",
    "pack:check": "pnpm build && node --import=tsx scripts/verifyPackages.ts",
    "prepare": "node --import=tsx scripts/installGitHooks.ts",
    "release": "node --import=tsx scripts/runRelizy.ts",
    "release:check": "node --import=tsx scripts/runRelizy.ts --patch --dry-run --no-publish --no-provider-release --no-push --no-commit --yes",
    "start": "pnpm --filter @gits/cli start",
    "test": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import=tsx --test apps/cli/src/service/CliApplication.integration.test.ts apps/cli/src/module/repoMirror/service/RepoMirrorCommand.integration.test.ts packages/core/src/service/ConcurrencyService.test.ts packages/core/src/service/gitUrl.test.ts packages/core/src/module/task/service/TaskConfigurationService.test.ts packages/core/src/module/task/service/TaskTemplateImportService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorLoggerService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorSchedulerService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorStoreService.test.ts packages/core/src/module/uninstall/service/GitsPersistenceService.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "relizy": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9"
}
