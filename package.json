{
  "name": "gits-workspace",
  "version": "0.2.0",
  "private": true,
  "homepage": "https://github.com/Mobiwuhu/gits#readme",
  "bugs": {
    "url": "https://github.com/Mobiwuhu/gits/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Mobiwuhu",
    "url": "https://github.com/Mobiwuhu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mobiwuhu/gits.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:watch": "pnpm --filter @usegits/core build && pnpm --recursive --parallel --if-present run build:watch",
    "check": "pnpm lint && pnpm format:check && pnpm arch:check && pnpm typecheck && pnpm test && pnpm pack:check",
    "arch:check": "node --import=tsx scripts/checkArchitecture.ts",
    "dev": "pnpm --filter @usegits/cli dev",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "link:global": "pnpm build && pnpm --dir apps/cli link --global",
    "pack:check": "pnpm build && node --import=tsx scripts/verifyPackages.ts && node --import=tsx scripts/publishPackages.ts --dry-run",
    "prepare": "node --import=tsx scripts/installGitHooks.ts",
    "publish:npm": "pnpm check && node --import=tsx scripts/publishPackages.ts",
    "publish:npm:check": "pnpm check",
    "release": "pnpm check && node --import=tsx scripts/runRelizy.ts",
    "release:check": "node --import=tsx scripts/runRelizy.ts --patch --dry-run --no-publish --no-provider-release --no-push --no-commit --yes",
    "test": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import=tsx --conditions=@usegits/source --test apps/cli/src/service/CliApplication.integration.test.ts apps/cli/src/module/repoMirror/service/RepoMirrorCommand.integration.test.ts packages/core/src/service/ConcurrencyService.test.ts packages/core/src/service/gitUrl.test.ts packages/core/src/module/task/service/TaskConfigurationService.test.ts packages/core/src/module/taskTemplate/service/TaskTemplateServices.test.ts packages/core/src/module/repoMirror/service/RepoMirrorLoggerService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorSchedulerService.test.ts packages/core/src/module/repoMirror/service/RepoMirrorStoreService.test.ts packages/core/src/module/uninstall/service/GitsPersistenceService.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "relizy": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9"
}
