{
  "name": "gits-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter gits dev",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "start": "pnpm --filter gits start",
    "test": "node --import=tsx --test apps/cli/src/presentation/cli/gits.integration.test.ts apps/cli/src/presentation/cli/repo-mirrors.integration.test.ts apps/cli/src/infrastructure/concurrency/concurrent-runner.test.ts apps/cli/src/infrastructure/config/jsonc-task-configuration-store.test.ts apps/cli/src/infrastructure/filesystem/node-task-template-importer.test.ts apps/cli/src/infrastructure/logging/pino-repo-mirror-logger.test.ts apps/cli/src/infrastructure/persistence/node-gits-persistence.test.ts apps/cli/src/infrastructure/repo-mirrors/jsonc-repo-mirror-store.test.ts apps/cli/src/infrastructure/scheduler/native-repo-mirror-scheduler.test.ts apps/cli/src/domain/git/remote-url.test.ts",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:"
  },
  "engines": {
    "node": ">=22.17.1",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9"
}
