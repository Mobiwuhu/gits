{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "error"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**"],
  "rules": {
    "eqeqeq": "error",
    "no-console": "warn",
    "typescript/consistent-type-imports": "error"
  }
}
