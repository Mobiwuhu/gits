{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "error"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**"],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "apps/cli/src/**/*Command.ts",
        "scripts/verifyPackages.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ],
  "rules": {
    "eqeqeq": "error",
    "no-console": "warn",
    "no-underscore-dangle": ["error", { "allow": ["arguments_"] }],
    "typescript/consistent-type-imports": "error"
  }
}
